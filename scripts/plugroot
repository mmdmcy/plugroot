#!/bin/sh
set -eu

root="${PLUGROOT_CODE_ROOT:-/opt/plugroot}"
bin="${PLUGROOT_BIN:-$root/bin/plugroot}"

if [ ! -x "$bin" ]; then
  echo "plugroot: cannot find plugroot binary at $bin" >&2
  exit 127
fi

if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1; then
  case "${1:-}" in
    apply|up|down|restart|logs|tui|backup|restore|emergency)
      exec sudo "$bin" --root "$root" "$@"
      ;;
  esac
fi

exec "$bin" --root "$root" "$@"
