# Per-host selfhost configuration. Copy to /opt/plugroot-state/.env on each
# host (or merge into the existing file, never overwrite secrets). All values
# here are host-specific; no secrets belong in this file beyond what the
# services themselves need.

# Tailnet IPv4 of THIS host (used to bind Forgejo + RustDesk relay).
TAILNET_IP=<this-host-tailnet-ipv4>

# plugroot: private bind address for this host (default 127.0.0.1).
PLUGROOT_PRIVATE_IP=<this-host-tailnet-ipv4>

# Forgejo public domain (tailnet hostname). Changing this invalidates
# existing git remotes on clients.
FORGEJO_DOMAIN=<this-host>.tailXXXXXX.ts.net
FORGEJO_APP_NAME=Selfhost Forgejo

# RustDesk relay address(es) hbbs tells clients about.
RUSTDESK_RELAY=<this-host-tailnet-ipv4>:21117

# Optional overrides.
# TZ=Europe/Amsterdam
# JELLYFIN_PUBLISHED_URL=http://HOST.example.ts.net:8096
# YTDLP_WEB_PORT=8790
