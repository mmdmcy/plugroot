#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${RELAYQUAY_ENV_FILE:-/var/lib/relayquay/relayquay.env}"
COMPOSE_DIR="$ROOT_DIR/deploy/compose"

usage() {
  cat <<'USAGE'
RelayQuay - RustOp Viewer private gateway helper

Usage:
  relayquay init
  relayquay doctor
  relayquay pause
  relayquay cover
  relayquay activate
  relayquay up [service...]
  relayquay down
  relayquay stop [service...]
  relayquay status
  relayquay logs [service...]
  relayquay config

Environment:
  RELAYQUAY_ENV_FILE=/var/lib/relayquay/relayquay.env
USAGE
}

load_env() {
  if [[ -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
  fi

  RELAYQUAY_STATE_DIR="${RELAYQUAY_STATE_DIR:-/var/lib/relayquay}"
  RELAYQUAY_BIND="${RELAYQUAY_BIND:-127.0.0.1}"
  RELAYQUAY_LISTEN_PORT="${RELAYQUAY_LISTEN_PORT:-8788}"
  RELAYQUAY_RESTART_POLICY="${RELAYQUAY_RESTART_POLICY:-unless-stopped}"
  CLOUDFLARED_PROTOCOL="${CLOUDFLARED_PROTOCOL:-quic}"
  ROV_UPSTREAM="${ROV_UPSTREAM:-127.0.0.1:45080}"
  RELAYQUAY_MODE="${RELAYQUAY_MODE:-active}"
  case "${RELAYQUAY_MODE,,}" in
    paused|pause|cover)
      RELAYQUAY_MODE="paused"
      RELAYQUAY_CADDYFILE="${RELAYQUAY_CADDYFILE:-./deploy/caddy/Caddyfile.paused}"
      ;;
    active|on|live)
      RELAYQUAY_MODE="active"
      RELAYQUAY_CADDYFILE="${RELAYQUAY_CADDYFILE:-./deploy/caddy/Caddyfile}"
      ;;
    *)
      echo "error: RELAYQUAY_MODE must be active or paused" >&2
      exit 2
      ;;
  esac
  export RELAYQUAY_BIND RELAYQUAY_CADDYFILE RELAYQUAY_LISTEN_PORT RELAYQUAY_MODE
  export RELAYQUAY_RESTART_POLICY RELAYQUAY_STATE_DIR CLOUDFLARED_PROTOCOL ROV_UPSTREAM
}

compose() {
  docker compose \
    --env-file "$ENV_FILE" \
    --project-directory "$ROOT_DIR" \
    -f "$COMPOSE_DIR/compose.yaml" \
    "$@"
}

cmd_init() {
  local state_owner="${RELAYQUAY_STATE_OWNER:-${SUDO_USER:-${USER}}}"
  local state_group="${RELAYQUAY_STATE_GROUP:-$(id -gn "$state_owner")}"

  sudo install -d -o "$state_owner" -g "$state_group" -m 700 "$(dirname "$ENV_FILE")"
  if [[ ! -f "$ENV_FILE" ]]; then
    sudo install -o "$state_owner" -g "$state_group" -m 600 "$ROOT_DIR/.env.example" "$ENV_FILE"
    echo "created $ENV_FILE"
  else
    sudo chown "$state_owner:$state_group" "$ENV_FILE"
    sudo chmod 600 "$ENV_FILE"
    echo "kept existing $ENV_FILE"
  fi

  load_env
  sudo install -d -o "$state_owner" -g "$state_group" -m 700 "$RELAYQUAY_STATE_DIR"
  sudo install -d -o "$state_owner" -g "$state_group" -m 700 "$RELAYQUAY_STATE_DIR/caddy"
}

cmd_doctor() {
  load_env
  local failed=0

  if command -v docker >/dev/null 2>&1; then
    echo "ok: docker is installed"
  else
    echo "error: docker is not installed"
    failed=1
  fi

  if [[ -f "$ENV_FILE" ]]; then
    echo "ok: private env file exists at $ENV_FILE"
  else
    echo "warn: private env file is missing; run ./bin/relayquay init"
  fi

  if [[ "${CLOUDFLARE_TUNNEL_TOKEN:-}" == "" || "${CLOUDFLARE_TUNNEL_TOKEN:-}" == "<your-cloudflare-tunnel-token>" ]]; then
    echo "warn: CLOUDFLARE_TUNNEL_TOKEN is not set in the private env file"
  else
    echo "ok: Cloudflare tunnel token is set"
  fi

  if [[ "${RELAYQUAY_PUBLIC_HOST:-}" == "" || "${RELAYQUAY_PUBLIC_HOST:-}" == "rov.example.com" ]]; then
    echo "warn: RELAYQUAY_PUBLIC_HOST is still an example value"
  else
    echo "ok: public hostname is configured"
  fi

  check_tcp_upstream "$ROV_UPSTREAM" "RustOp Viewer"

  if curl -fsS "http://${RELAYQUAY_BIND}:${RELAYQUAY_LISTEN_PORT}/healthz" >/dev/null 2>&1; then
    echo "ok: local gateway health endpoint is responding"
  else
    echo "warn: local gateway is not responding yet"
  fi

  return "$failed"
}

check_tcp_upstream() {
  local upstream="$1"
  local label="$2"
  local host="${upstream%:*}"
  local port="${upstream##*:}"

  if timeout 2 bash -c ":</dev/tcp/${host}/${port}" >/dev/null 2>&1; then
    echo "ok: $label upstream reachable at $upstream"
  else
    echo "warn: $label upstream not reachable at $upstream"
  fi
}

set_env_var() {
  local key="$1"
  local value="$2"
  local state_owner="${RELAYQUAY_STATE_OWNER:-${SUDO_USER:-${USER}}}"
  local state_group="${RELAYQUAY_STATE_GROUP:-$(id -gn "$state_owner")}"

  sudo install -d -o "$state_owner" -g "$state_group" -m 700 "$(dirname "$ENV_FILE")"
  if [[ ! -f "$ENV_FILE" ]]; then
    sudo install -o "$state_owner" -g "$state_group" -m 600 "$ROOT_DIR/.env.example" "$ENV_FILE"
  fi

  if grep -qE "^${key}=" "$ENV_FILE"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
  else
    printf '\n%s=%s\n' "$key" "$value" >>"$ENV_FILE"
  fi
}

cmd_pause() {
  set_env_var RELAYQUAY_MODE paused
  load_env
  compose up -d --force-recreate caddy
  compose stop cloudflared
  echo "paused: cover mode is configured and cloudflared is stopped"
}

cmd_cover() {
  set_env_var RELAYQUAY_MODE paused
  load_env
  compose up -d --force-recreate caddy cloudflared
  echo "covered: cloudflared is running but Caddy serves the neutral cover response"
}

cmd_activate() {
  set_env_var RELAYQUAY_MODE active
  load_env
  compose up -d --force-recreate caddy cloudflared
  echo "active: cloudflared is running and Caddy proxies to RustOp Viewer"
}

cmd="${1:-help}"
case "$cmd" in
  init)
    cmd_init
    ;;
  doctor)
    cmd_doctor
    ;;
  pause)
    cmd_pause
    ;;
  cover)
    cmd_cover
    ;;
  activate)
    cmd_activate
    ;;
  up)
    load_env
    shift
    compose up -d "$@"
    ;;
  down)
    load_env
    compose down
    ;;
  stop)
    load_env
    shift
    compose stop "$@"
    ;;
  status|ps)
    load_env
    compose ps
    ;;
  logs)
    load_env
    shift
    compose logs -f --tail=200 "$@"
    ;;
  config)
    load_env
    compose config
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
