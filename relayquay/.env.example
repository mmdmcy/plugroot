# Copy this file to /var/lib/relayquay/relayquay.env.
# Keep the copied file private and out of Git.

# Public hostname protected by Cloudflare Access.
RELAYQUAY_PUBLIC_HOST=rov.example.com

# Local loopback listener used by cloudflared.
RELAYQUAY_BIND=127.0.0.1
RELAYQUAY_LISTEN_PORT=8788

# RelayQuay private state.
RELAYQUAY_STATE_DIR=/var/lib/relayquay

# RustOp Viewer host runtime. Keep ROV loopback-only.
ROV_UPSTREAM=127.0.0.1:45080

# Runtime mode. Use "active" for the private upstream or "paused" for the
# generic Solotu placeholder.
RELAYQUAY_MODE=paused

# Cloudflare Tunnel token. Set this only in the private env file.
CLOUDFLARE_TUNNEL_TOKEN="<your-cloudflare-tunnel-token>"

# Network and lifecycle controls.
RELAYQUAY_RESTART_POLICY=unless-stopped
CLOUDFLARED_PROTOCOL=quic

# Image tags.
CADDY_TAG=2-alpine
CLOUDFLARED_TAG=2026.6.1
