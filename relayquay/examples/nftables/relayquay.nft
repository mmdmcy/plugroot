#!/usr/sbin/nft -f

# Example only. Review interfaces and private ranges before applying.

table inet relayquay {
  chain input {
    type filter hook input priority 0; policy accept;

    iifname "lo" accept

    # RelayQuay and ROV are intended to be reached locally by cloudflared and
    # Caddy. Drop direct non-loopback attempts to those local service ports.
    tcp dport { 8788, 45080 } drop
  }
}
