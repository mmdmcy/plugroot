# Copy to the private state root and adjust for your host.
# Keep real .env files outside Git checkouts. The manifest defaults to a
# sibling `../plugroot-state` directory when these two variables are unset.
# PLUGROOT_STATE_ROOT=/srv/plugroot-state
PLUGROOT_HOSTNAME=plugroot-host
PLUGROOT_PRIVATE_IP=127.0.0.1
PLUGROOT_USER=plugroot
# PLUGROOT_REPO_DIR=/srv/plugroot-state/repos
PLUGROOT_WEB_BIND=127.0.0.1:8786
PLUGROOT_WEB_USER=plugroot
# Required unless PLUGROOT_WEB_BIND lists only loopback addresses.
PLUGROOT_WEB_PASSWORD=
TZ=UTC
PUID=1000
PGID=1000
EXAMPLE_WEB_PORT=8080
